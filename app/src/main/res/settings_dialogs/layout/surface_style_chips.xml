<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="30dp"
    android:layout_marginBottom="15dp"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <carbon.widget.FrameLayout
        android:id="@+id/style_material"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/ripple"
        app:carbon_cornerRadius="20dp"
        app:carbon_stroke="?attr/colorOutlineVariant"
        app:carbon_strokeWidth="1dp">

        <adrianogba.stario.launcher.ui.common.glass.MaterialPreviewView
            android:id="@+id/style_material_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/dm_sans_medium"
            android:letterSpacing="-0.03"
            android:text="@string/surface_material"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/style_material_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:src="@drawable/ic_check" />

    </carbon.widget.FrameLayout>

    <carbon.widget.FrameLayout
        android:id="@+id/style_glass"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/ripple"
        app:carbon_cornerRadius="20dp"
        app:carbon_stroke="?attr/colorOutlineVariant"
        app:carbon_strokeWidth="1dp">

        <adrianogba.stario.launcher.ui.common.glass.GlassPreviewView
            android:id="@+id/style_glass_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/dm_sans_medium"
            android:letterSpacing="-0.03"
            android:text="@string/surface_liquid_glass"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/style_glass_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:src="@drawable/ic_check" />

    </carbon.widget.FrameLayout>

</LinearLayout>
